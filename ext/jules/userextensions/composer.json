        {
            "name": "Jules",
            "homepage": "http://www.example.com"
        }
    ],
    "require": {
        "php": ">=7.1",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "User Extensions",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0"
        },
        "acp-module-class": "jules\\userextensions\\acp\\userextensions_info"
    }
